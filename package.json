{
  "name": "codefunke",
  "version": "1.0.0",
  "private": true,
  "description": "Codefunke – Programmieren lernen von Scratch bis Java",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "typecheck": "tsc -p client --noEmit && tsc -p server --noEmit",
    "check:content": "vitest run content"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
