  "quiz": {
    "questions": [
      {
        "type": "single",
        "question": "Was macht „falls … dann“?",
        "options": [
          "Es wiederholt Blöcke für immer",
          "Es führt Blöcke nur aus, wenn eine Bedingung stimmt",
          "Es startet das Programm",
          "Es löscht alle Blöcke"
        ],
        "answer": 1
      },
      {
        "type": "single",
        "question": "Funki steht bei x = 20. Was sagt er?",
        "blocks": [
          "wenn_start",
          "  falls (> (x) 50)",
          "    sage \"groß\""
        ],
        "options": [
          "„groß“",
          "Nichts",
          "„20“",
          "„klein“"
        ],
        "answer": 1,
        "explanation": "20 ist nicht größer als 50 – die Bedingung ist falsch, also passiert nichts."
      },
      {
        "type": "single",
        "question": "Welche Form haben Bedingungs-Blöcke wie „wird Rand berührt?“",
        "options": [
