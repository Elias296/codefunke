        },
        {
          "type": "output",
          "inputs": [
            "60"
          ],
          "expected": "^bestanden$",
          "match": "regex",
          "message": "Bei 60 Punkten soll „bestanden“ herauskommen."
        },
        {
          "type": "output",
          "inputs": [
            "20"
          ],
          "expected": "^nicht bestanden$",
          "match": "regex",
          "message": "Bei 20 Punkten soll „nicht bestanden“ herauskommen."
        }
      ],
      "hints": [
        "Für die mittleren Fälle brauchst du `elif`. Die Reihenfolge ist wichtig: von groß nach klein.",
        "`elif punkte >= 75:` → gut, `elif punkte >= 50:` → bestanden, `else:` → nicht bestanden"
      ],
      "solution": [
        "punkte = int(input(\"Wie viele Punkte? \"))",
        "",
        "if punkte >= 90:",
        "    print(\"sehr gut\")",
        "elif punkte >= 75:",
        "    print(\"gut\")",
        "elif punkte >= 50:",
