          "type": "output",
          "inputs": [
            "70"
          ],
          "expected": "Eintritt frei!",
          "match": "contains"
        },
        {
          "type": "output",
          "inputs": [
            "65"
          ],
          "expected": "Eintritt frei!",
          "match": "contains",
          "message": "Mit genau 65 ist der Eintritt frei („ab 65“ heißt `>= 65`)."
        },
        {
          "type": "output",
          "inputs": [
            "12"
          ],
          "expected": "Kinderticket: 5 Euro",
          "match": "contains"
        },
        {
          "type": "output",
          "inputs": [
            "30"
          ],
          "expected": "Erwachsenenticket: 9 Euro",
          "match": "contains"
        }
      ],
      "hints": [
        "Die erste Bedingung: `if alter < 6 or alter >= 65:`",
        "Danach `elif alter < 18:` für das Kinderticket und `else:` für Erwachsene."
      ],
      "solution": [
        "alter = int(input(\"Wie alt bist du? \"))",
        "if alter < 6 or alter >= 65:",
        "    print(\"Eintritt frei!\")",
        "elif alter < 18:",
        "    print(\"Kinderticket: 5 Euro\")",
        "else:",
        "    print(\"Erwachsenenticket: 9 Euro\")"
      ],
      "kind": "code",
      "language": "python"
