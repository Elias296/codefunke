  "project": {
    "title": "Highscore-Liste",
    "kind": "code",
    "language": "python",
    "description": "Bau eine **Highscore-Liste**: Das Programm fragt so lange nach Punktzahlen, bis man **nichts** eingibt (nur Enter). Dann zeigt es die **Top 3** (von groß nach klein), den Durchschnitt und wie viele Runden gespielt wurden.",
    "starter": [
      "punkte = []",
      "",
      "while True:",
      "    eingabe = input(\"Punkte (Enter = fertig): \")",
      "    if eingabe == \"\":",
      "        break"
    ],
    "requirements": [
      "Eingaben werden in einer Liste gesammelt.",
      "Leere Eingabe beendet das Sammeln.",
      "Die Top 3 werden sortiert ausgegeben.",
      "Durchschnitt und Anzahl werden angezeigt."
    ],
    "checks": [
      {
        "type": "code",
        "pattern": "\\.append\\(",
        "message": "Sammle die Punkte mit `punkte.append(...)` in der Liste."
      },
      {
        "type": "code",
        "pattern": "sorted\\(|\\.sort\\(",
        "message": "Sortiere die Liste mit `sorted(...)` oder `.sort()`."
      },
      {
        "type": "assert",
        "inputs": [
          "5",
          "12",
          "8",
          "3",
          ""
        ],
        "code": "assert '12' in __output__ and __output__.find('12') < __output__.rfind('8') and '4' in __output__",
        "message": "Bei 5, 12, 8, 3 sollen die Top 3 (12, 8, 5) erscheinen – und die Anzahl 4."
      }
    ],
    "ideas": [
      "Zeig neben jedem Platz eine Medaille: 🥇 🥈 🥉",
      "Frag zusätzlich nach Namen und speichere sie in einer zweiten Liste."
    ],
    "example": [
      "punkte = []",
      "",
      "while True:",
      "    eingabe = input(\"Punkte (Enter = fertig): \")",
      "    if eingabe == \"\":",
      "        break",
      "    punkte.append(int(eingabe))",
      "",
      "top = sorted(punkte, reverse=True)",
      "print(\"Top 3:\")",
      "for platz in range(min(3, len(top))):",
      "    print(f\"{platz + 1}. {top[platz]}\")",
      "print(f\"Gespielte Runden: {len(punkte)}\")",
      "if punkte:",
      "    print(f\"Durchschnitt: {sum(punkte) / len(punkte)}\")"
